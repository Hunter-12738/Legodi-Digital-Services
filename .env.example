# Supabase → Project Settings → API. Both values are safe for the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL (used for canonical links, Open Graph and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.example.co.za

# Only for `npm run db:push` (Project Settings → Database → Session pooler URI). Never used by the app.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The app never uses the service_role key. Do not add it here.
